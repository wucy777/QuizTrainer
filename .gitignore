# ── Flutter / Dart ──
flutter_app/.dart_tool/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/.packages
flutter_app/build/
flutter_app/.pub-cache/
flutter_app/.pub/
# 注意：pubspec.lock 应当提交（应用而非库），以保证可复现构建

# ── Windows 构建产物 ──
flutter_app/windows/flutter/ephemeral/
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln

# ── Android 构建产物 ──
flutter_app/android/.gradle/
flutter_app/android/app/.cxx/
flutter_app/android/local.properties
flutter_app/android/app/debug/
flutter_app/android/app/profile/
flutter_app/android/app/release/
*.jks
*.keystore

# ── IDE ──
.idea/
.vscode/
*.iml
*.iws

# ── 打包中间产物 ──
packaging/_build/

# ── 本项目产出 ──
output/
_cache/
_backup/

# ── 操作系统 ──
Thumbs.db
Desktop.ini
.DS_Store

# ── 题库：不要提交真实题库 ──
# 本程序不内置题库，示例见 examples/
*.local.json
